    <update id="increaseRefCount">
        UPDATE PEACH_FILE_OBJECT
        SET REF_COUNT = COALESCE(REF_COUNT, 0) + #{count,jdbcType=INTEGER},
            MODIFY_TIME = #{modifyTime,jdbcType=VARCHAR},
            MODIFIER_ID = #{modifierId,jdbcType=VARCHAR}
        WHERE OBJECT_ID = #{objectId,jdbcType=VARCHAR}
    </update>

    <update id="decreaseRefCount">
        UPDATE PEACH_FILE_OBJECT
        SET REF_COUNT = CASE
                            WHEN COALESCE(REF_COUNT, 0) - #{count,jdbcType=INTEGER} &lt; 0 THEN 0
                            ELSE COALESCE(REF_COUNT, 0) - #{count,jdbcType=INTEGER}
                        END,
            MODIFY_TIME = #{modifyTime,jdbcType=VARCHAR},
            MODIFIER_ID = #{modifierId,jdbcType=VARCHAR}
        WHERE OBJECT_ID = #{objectId,jdbcType=VARCHAR}
    </update>

