<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peach.fileservice.dao.FileSaasScopeDao">
    <select id="findEnabledTenantBusinessId" resultType="java.lang.String">
        SELECT TENANT_ID
        FROM PEACH_TENANT
        WHERE ID = #{tenantRefId,jdbcType=VARCHAR}
          AND STATUS = 'ENABLE' AND IS_DELETE = 0
    </select>
</mapper>
