    <select id="selectByUserId" resultType="com.peach.auth.vo.UserOrgVO" parameterType="string">
        SELECT
            uo.ID as id,
            uo.USER_ID as userId,
            uo.TENANT_ID as tenantId,
            t.TENANT_CODE as tenantCode,
            t.TENANT_NAME as tenantName,
            uo.ORG_ID as orgId,
            o.ORG_CODE as orgCode,
            o.ORG_NAME as orgName,
            uo.IS_DEFAULT as isDefault,
            uo.STATUS as status,
            uo.IS_DELETE as isDelete,
            uo.CREATED_TIME as createdTime,
            uo.CREATOR_ID as creatorId,
            uo.MODIFY_TIME as modifyTime,
            uo.MODIFIER_ID as modifierId
        FROM PEACH_USER_ORG uo
        LEFT JOIN PEACH_TENANT t ON uo.TENANT_ID = t.TENANT_ID
        LEFT JOIN PEACH_ORGANIZATION o ON uo.ORG_ID = o.ORG_ID
        WHERE uo.USER_ID = #{userId,jdbcType=VARCHAR}
          AND (uo.IS_DELETE IS NULL OR uo.IS_DELETE != 1)
          AND (t.IS_DELETE IS NULL OR t.IS_DELETE != 1)
          AND (o.IS_DELETE IS NULL OR o.IS_DELETE != 1)
        ORDER BY uo.IS_DEFAULT DESC, t.SORT_NUM ASC, o.SORT_NUM ASC
    </select>

