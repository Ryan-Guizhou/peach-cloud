        <if test="roleCode != null and roleCode != ''">AND LOCATE(#{roleCode}, ROLE_CODE) &gt; 0</if>
        <if test="roleName != null and roleName != ''">AND LOCATE(#{roleName}, ROLE_NAME) &gt; 0</if>
        <if test="keyword != null and keyword != ''">AND (LOCATE(#{keyword}, ROLE_CODE) &gt; 0 OR LOCATE(#{keyword}, ROLE_NAME) &gt; 0)</if>
