    <select id="selectByUser" resultType="com.peach.auth.vo.RoleVO" parameterType="com.peach.auth.qo.RoleQO">
        SELECT
            r.role_code as roleCode,
            r.role_name as roleName,
            r.role_id as roleId,
            p.party_code as userCode,
            r.tenant_id as tenantId,
            r.org_id as orgId,
            r.SKIP_URL as skipUrl
        FROM PEACH_ROLE r INNER JOIN PEACH_AUTH_PARTY p
            ON r.tenant_id = p.tenant_id
           AND r.org_id = p.org_id
           AND r.role_code = p.role_code
        <where>
            (r.is_delete is null OR r.is_delete != 1)
            AND (p.is_delete is null OR p.is_delete != 1)
            <if test="tenantId != null and tenantId != ''">
                AND r.tenant_id = #{tenantId,jdbcType=VARCHAR}
            </if>
            <if test="orgId != null and orgId != ''">
                AND r.org_id = #{orgId,jdbcType=VARCHAR}
            </if>
            <if test="userCode != null and userCode != ''">
                and p.party_code = #{userCode}
            </if>
        </where>
    </select>


    <select id="selectByQO" resultType="com.peach.auth.vo.RoleVO">
        SELECT <include refid="allColumnAlias"/> FROM PEACH_ROLE
        WHERE TENANT_ID = #{tenantId} AND ORG_ID = #{orgId} AND COALESCE(IS_DELETE,0) = 0
