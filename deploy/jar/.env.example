TZ=Asia/Shanghai

# Java runtime
JAVA_BIN=java
SPRING_PROFILES_ACTIVE=docker

# Local debug profile. Production can override this in deploy/jar/.env.
JAVA_OPTS="-Xms128m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=300 -Dfile.encoding=UTF-8"

# Middleware addresses for java -jar processes running on the host.
# This script does not start or initialize MySQL, Redis, or Nacos.
NACOS_SERVER_ADDR=127.0.0.1:8849
SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR=127.0.0.1:8849
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=127.0.0.1:8849
SPRING_CLOUD_NACOS_CONFIG_NAMESPACE=peach-cloud
SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=peach-cloud
SPRING_CLOUD_NACOS_CONFIG_GROUP=PEACH-CLOUD
SPRING_CLOUD_NACOS_DISCOVERY_GROUP=PEACH-CLOUD
SPRING_CLOUD_NACOS_CONFIG_FILE_EXTENSION=yml
SPRING_CLOUD_NACOS_CONFIG_ENCODE=UTF-8

MYSQL_DATABASE=peach_cloud
MYSQL_HOST=127.0.0.1:3307
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password

REDIS_HOST=127.0.0.1:6380
REDIS_PASSWORD=change_me_redis_password

# Service ports
GATEWAY_PORT=18080
AUTH_PORT=18081
MONITOR_PORT=18082
FILESERVICE_PORT=18083
MESSAGE_PORT=18084
SETTING_PORT=18085
GENERATOR_PORT=18086

# Runtime directories are isolated under deploy/jar/runtime by default.
PEACH_UPLOAD_ROOT=runtime/upload/peach-fileservice
STOP_TIMEOUT=30
