    <profiles>
        <profile>
            <id>peach-repository-fallback</id>
            <repositories>
                <repository>
                    <id>nexus-public</id>
                    <name>Peach Nexus Public Repository</name>
                    <url>@MAVEN_NEXUS_URL@/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
                <repository>
                    <id>aliyun-public</id>
                    <name>Aliyun Maven Public Repository</name>
                    <url>@MAVEN_ALIYUN_PUBLIC_URL@</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>nexus-public</id>
                    <name>Peach Nexus Public Repository</name>
                    <url>@MAVEN_NEXUS_URL@/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>aliyun-public</id>
                    <name>Aliyun Maven Public Repository</name>
                    <url>@MAVEN_ALIYUN_PUBLIC_URL@</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>peach-repository-fallback</activeProfile>
    </activeProfiles>

    <mirrors>
        <mirror>
            <id>maven-default-http-blocker</id>
            <mirrorOf>external:http:*,!nexus-public</mirrorOf>
            <url>http://0.0.0.0/</url>
            <blocked>false</blocked>
        </mirror>
    </mirrors>

</settings>
