COMPOSE_PROJECT_NAME=peach-cloud
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

PEACH_IMAGE_PREFIX=localhost:5000/peach-cloud
PEACH_IMAGE_TAG=latest
IMAGE_AUTHORS=Mr Shu
IMAGE_VENDOR=Peach Cloud

MYSQL_VERSION=8.0
MYSQL_DATABASE=peach_cloud
MYSQL_HOST_PORT=3307
MYSQL_HOST=mysql:3306

REDIS_VERSION=7.2-alpine
REDIS_HOST_PORT=6380
REDIS_HOST=redis:6379

NACOS_VERSION=v2.3.2
NACOS_HOST_PORT=8849
NACOS_GRPC_HOST_PORT=9850
NACOS_SERVER_ADDR=nacos:8848
NACOS_AUTH_ENABLE=false
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE_ID=peach-cloud
NACOS_NAMESPACE_NAME=peach-cloud
NACOS_GROUP=PEACH-CLOUD

MONGO_VERSION=7.0
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_HOST_PORT=27017
MONGO_DATABASE=peach_cloud
MONGO_ROOT_USERNAME=peach_root
MONGO_APP_USERNAME=peach

ROCKETMQ_VERSION=5.3.1
ROCKETMQ_CLUSTER_NAME=PeachCluster
ROCKETMQ_NAMESRV_HOST_PORT=9876
ROCKETMQ_BROKER_HOST_PORT=10911
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_DASHBOARD_VERSION=latest
ROCKETMQ_DASHBOARD_HOST_PORT=18088
ROCKETMQ_TOPIC_PROVISION_MODE=ensure
PEACH_ROCKET_TOPIC_AUTO_CREATE=true

PEACH_STORAGE_PRIMARY=local

REGISTRY_VERSION=3
REGISTRY_UI_VERSION=latest
GITLAB_VERSION=latest
NEXUS_VERSION=3.75.1
NGINX_VERSION=1.25-alpine
JENKINS_IMAGE=peach-jenkins:lts-jdk21
NEXUS_HOST_PORT=8081
MAVEN_LOCAL_REPOSITORY=/var/jenkins_home/.m2/repository
MAVEN_NEXUS_URL=http://nexus:8081
PEACH_NEXUS_URL=http://nexus:8081
MAVEN_PROXY_NON_PROXY_HOSTS=localhost|127.0.0.1|nexus|registry|10.*|172.*|192.168.*

PROMETHEUS_VERSION=v3.12.0
PROMETHEUS_RETENTION=15d
PROMETHEUS_HOST_PORT=9090
TEMPO_VERSION=2.10.7
OTEL_COLLECTOR_VERSION=0.153.0
LOKI_VERSION=3.7.4
ALLOY_VERSION=v1.18.0
GRAFANA_VERSION=13.1.0
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin

MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
MANAGEMENT_OTLP_TRACING_EXPORT_ENABLED=true
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

GATEWAY_PORT=18080
AUTH_PORT=18081
MONITOR_PORT=18082
FILESERVICE_PORT=18083
MESSAGE_PORT=18084
SETTING_PORT=18085
GENERATOR_PORT=18086
SCHEDULED_PORT=18087
DEVOPS_HTTP_PORT=80
