# This is the only local/private file operators need to maintain.
# Existing Jenkins credentials based on the previous full deploy.env remain compatible:
# any extra values in the secret file override repository defaults.

# Docker-host-visible runtime location. Docker Desktop Windows example:
# /host_mnt/d/Coding/mine/peach-cloud/deploy-pipline/runtime
PEACH_RUNTIME_ROOT=/host_mnt/d/path/to/peach-cloud/deploy-pipline/runtime
PEACH_LOG_ROOT=/host_mnt/d/path/to/peach-cloud/deploy-pipline/runtime/logs

MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
REDIS_PASSWORD=change_me_redis_password
MONGO_ROOT_PASSWORD=change_me_mongo_root_password
MONGO_APP_PASSWORD=change_me_mongo_app_password

MAVEN_NEXUS_USERNAME=Development
MAVEN_NEXUS_PASSWORD=change_me_nexus_password
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# Optional external storage credentials used when rendering Nacos configuration.
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
COS_ACCESS_KEY=
COS_SECRET_KEY=

# Optional only when Nacos auth is enabled or local defaults differ.
# NACOS_AUTH_ENABLE=true
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=change_me_nacos_password

# Optional Maven proxy overrides.
# MAVEN_PROXY_HOST=proxy.example.com
# MAVEN_PROXY_PORT=8080
# MAVEN_PROXY_PROTOCOL=http
# MAVEN_PROXY_ID=corp-proxy
# MAVEN_PROXY_ACTIVE=true
# MAVEN_PROXY_USERNAME=proxy_user
# MAVEN_PROXY_PASSWORD=change_me_proxy_password
