COMPOSE_PROJECT_NAME=peach-cloud
TZ=Asia/Shanghai

# Image metadata. Jenkins overrides PEACH_IMAGE_TAG with the Git commit SHA.
PEACH_IMAGE_TAG=latest
IMAGE_AUTHORS="Mr Shu"
IMAGE_VENDOR="Peach Cloud"
SPRING_PROFILES_ACTIVE=docker
JAVA_REQUIRED_MAJOR=21
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# Absolute path visible to the Docker daemon. Docker Desktop + Jenkins socket
# uses the /host_mnt/<drive>/... form. Keep all file logs under the deploy pipeline runtime directory.
PEACH_LOG_ROOT=/host_mnt/c/path/to/peach-cloud/deploy-pipline/pipline/runtime

# Observability. Applications join peach-devops for OTLP export and internal metric scraping.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
MANAGEMENT_OTLP_TRACING_EXPORT_ENABLED=true
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# Pinned observability component versions.
PROMETHEUS_VERSION=v3.12.0
OTEL_COLLECTOR_VERSION=0.153.0
TEMPO_VERSION=2.10.7
LOKI_VERSION=3.7.4
ALLOY_VERSION=v1.18.0
GRAFANA_VERSION=13.1.0
PROMETHEUS_RETENTION=15d
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# RocketMQ. NameServer and Broker run with the DevOps stack before applications.
ROCKETMQ_VERSION=5.3.1
ROCKETMQ_NAMESRV_HOST_PORT=9876
ROCKETMQ_BROKER_HOST_PORT=10911
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
PEACH_ROCKET_TOPIC_AUTO_CREATE=true

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=peach_cloud
MYSQL_HOST_PORT=3307
MYSQL_HOST=mysql:3306

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_HOST_PORT=6380
REDIS_HOST=redis:6379

# Object storage
OSS_ACCESS_KEY=change_me_oss_access_key
OSS_SECRET_KEY=change_me_oss_secret_key
COS_ACCESS_KEY=change_me_cos_access_key
COS_SECRET_KEY=change_me_cos_secret_key

# Nacos
NACOS_HOST_PORT=8849
NACOS_GRPC_HOST_PORT=9850
NACOS_SERVER_ADDR=nacos:8848
NACOS_AUTH_ENABLE=false
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE_ID=peach-cloud
NACOS_NAMESPACE_NAME=peach-cloud
NACOS_GROUP=PEACH-CLOUD

# Service ports. They are only exposed inside the Docker network.
GATEWAY_PORT=18080
AUTH_PORT=18081
MONITOR_PORT=18082
FILESERVICE_PORT=18083
MESSAGE_PORT=18084
SETTING_PORT=18085
GENERATOR_PORT=18086
SCHEDULED_PORT=18087

# Maven / Nexus（可选）

# Browser UI: http://nexus.peachsoft.com  直连: http://localhost:8081
NEXUS_HOST_PORT=8081

# Jenkins 会基于 deploy-pipline/maven/settings.xml 自动生成 settings.generated.xml。
# 默认不需要配置 Maven settings 路径；只在模板位置被你改掉时设置。
# MAVEN_SETTINGS_TEMPLATE=/var/jenkins_home/workspace/<job>/deploy-pipline/maven/settings.xml

# CI 容器内 Maven 本地仓库和仓库地址。
MAVEN_LOCAL_REPOSITORY=/var/jenkins_home/.m2/repository
MAVEN_NEXUS_URL=http://nexus:8081
MAVEN_ALIYUN_PUBLIC_URL=https://maven.aliyun.com/repository/public

# 兼容旧变量；未设置 MAVEN_NEXUS_URL 时 Jenkinsfile 会读取 PEACH_NEXUS_URL。
PEACH_NEXUS_URL=http://nexus:8081

# Nexus 关闭匿名读时配置；两项都存在才会生成 <servers>。
MAVEN_NEXUS_USERNAME=Development
MAVEN_NEXUS_PASSWORD=change_me_nexus_password

# Maven 出网代理，可选。MAVEN_PROXY_HOST 和 MAVEN_PROXY_PORT 都存在才会生成 <proxies>。
# MAVEN_PROXY_HOST=proxy.example.com
# MAVEN_PROXY_PORT=8080
# MAVEN_PROXY_PROTOCOL=http
# MAVEN_PROXY_ID=corp-proxy
# MAVEN_PROXY_ACTIVE=true
# MAVEN_PROXY_USERNAME=proxy_user
# MAVEN_PROXY_PASSWORD=change_me_proxy_password
# Maven env 会被 Jenkins shell source；包含 | 的值必须加引号。
# MAVEN_PROXY_NON_PROXY_HOSTS="localhost|127.0.0.1|nexus|*.aliyun.com|maven.aliyun.com|10.*|172.*|192.168.*"
