    "peach-setting": {"type":"backend","module":"peach-setting/peach-setting-launch","composeService":"peach-setting","paths":["peach-setting/"]},
    "peach-generator": {"type":"backend","module":"peach-generator/peach-generator-launch","composeService":"peach-generator","paths":["peach-generator/"]},
