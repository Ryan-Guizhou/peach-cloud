pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(
            name: 'DEPLOY_SERVICES',
            defaultValue: 'peach-gateway peach-auth peach-monitor peach-fileservice peach-message peach-setting peach-generator peach-scheduled peach-front',
            description: '本次构建和部署的业务服务，使用空格或逗号分隔；可填写 all。',
            trim: true
        )
        booleanParam(
            name: 'STOP_UNSELECTED_SERVICES',
            defaultValue: false,
            description: '是否停止本次未选择的业务服务；默认保留其当前运行状态。'
        )
    }

    environment {
        REGISTRY = 'localhost:5000'
        IMAGE_PREFIX = "${REGISTRY}/peach-cloud"
        MAVEN_IMAGE = 'peach-ci/maven-node:3.9.11-eclipse-temurin-21-node22'
        DEPLOY_COMPOSE_FILE = 'deploy-pipline/docker-compose.deploy.yml'
        DEPLOY_ENV_CREDENTIAL = 'peach-deploy-env'
        DEPLOY_ROOT = '/var/jenkins_home/peach-cloud-deploy'
        DEPLOY_NETWORK = 'peach-cloud-runtime'
        DEVOPS_NETWORK = 'peach-devops'
        ALL_APPLICATION_SERVICES = 'peach-gateway peach-auth peach-monitor peach-fileservice peach-message peach-setting peach-generator peach-scheduled peach-front'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Resolve deployment targets') {
            steps {
                script {
                    def allowed = env.ALL_APPLICATION_SERVICES.tokenize(' ')
                    def requested = params.DEPLOY_SERVICES.split(/[\s,]+/)
                            .findAll { it }
                            .unique()
                    if (requested.contains('all')) {
                        requested = allowed
                    }
                    if (requested.isEmpty()) {
                        error 'DEPLOY_SERVICES must contain at least one service or all.'
                    }
                    def invalid = requested - allowed
                    if (!invalid.isEmpty()) {
                        error "Unsupported DEPLOY_SERVICES value: ${invalid.join(', ')}"
                    }
                    env.SELECTED_SERVICES = requested.join(' ')
                    env.UNSELECTED_SERVICES = (allowed - requested).join(' ')
                    env.STOP_UNSELECTED = params.STOP_UNSELECTED_SERVICES.toString()
                    echo "Selected application services: ${env.SELECTED_SERVICES}"
                }
            }
        }

        stage('Validate Jenkins credentials') {
            steps {
                script {
                    try {
                        withCredentials([file(credentialsId: env.DEPLOY_ENV_CREDENTIAL, variable: 'DEPLOY_ENV_FILE')]) {
                            sh '''
                                test -s "$DEPLOY_ENV_FILE"
                            '''
                        }
                    } catch (err) {
                        error "Missing Jenkins Secret file credential '${env.DEPLOY_ENV_CREDENTIAL}'. Create it in Manage Jenkins -> Credentials -> System -> Global credentials, choose Kind 'Secret file', upload a .env file based on deploy-pipline/peach-deploy.env.example, and set ID to '${env.DEPLOY_ENV_CREDENTIAL}'."
                    }
                }
            }
        }

        stage('Build CI image') {
            steps {
                sh '''
                    docker build \
                      -f deploy-pipline/pipline/maven-node/Dockerfile \
                      -t "$MAVEN_IMAGE" \
                      deploy-pipline/pipline/maven-node
                '''
            }
        }

        stage('Maven package') {
            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            steps {
                withCredentials([file(credentialsId: env.DEPLOY_ENV_CREDENTIAL, variable: 'DEPLOY_ENV_FILE')]) {
                    sh '''
                        set -eu

                        set -a
                        . "$DEPLOY_ENV_FILE"
                        set +a

                        mkdir -p /var/jenkins_home/.m2
                        MAVEN_SETTINGS_TEMPLATE="${MAVEN_SETTINGS_TEMPLATE:-$WORKSPACE/deploy-pipline/maven/settings.xml}"
                        MAVEN_SETTINGS_GENERATED="/var/jenkins_home/.m2/settings.generated.xml"
                        if [ ! -f "$MAVEN_SETTINGS_TEMPLATE" ]; then
                          echo "Maven settings template not found: $MAVEN_SETTINGS_TEMPLATE" >&2
                          exit 1
                        fi

                        export MAVEN_SETTINGS_TEMPLATE
                        export MAVEN_SETTINGS_GENERATED
                        export MAVEN_LOCAL_REPOSITORY="${MAVEN_LOCAL_REPOSITORY:-/var/jenkins_home/.m2/repository}"
                        export MAVEN_NEXUS_URL="${MAVEN_NEXUS_URL:-${PEACH_NEXUS_URL:-http://nexus:8081}}"
                        export PEACH_NEXUS_URL="$MAVEN_NEXUS_URL"
                        export MAVEN_ALIYUN_PUBLIC_URL="${MAVEN_ALIYUN_PUBLIC_URL:-https://maven.aliyun.com/repository/public}"
                        export MAVEN_PROXY_ID="${MAVEN_PROXY_ID:-corp-proxy}"
                        export MAVEN_PROXY_ACTIVE="${MAVEN_PROXY_ACTIVE:-true}"
                        export MAVEN_PROXY_PROTOCOL="${MAVEN_PROXY_PROTOCOL:-http}"
                        export MAVEN_PROXY_NON_PROXY_HOSTS="${MAVEN_PROXY_NON_PROXY_HOSTS:-localhost|127.0.0.1|nexus|*.aliyun.com|maven.aliyun.com|10.*|172.*|192.168.*}"

                        node deploy-pipline/scripts/render-maven-settings.mjs

                        echo "Checking Maven CI image: $MAVEN_IMAGE"
                        docker image inspect "$MAVEN_IMAGE" >/dev/null

                        echo "Checking Docker network: $DEVOPS_NETWORK"
                        docker network inspect "$DEVOPS_NETWORK" >/dev/null

                        echo "Checking Maven container runtime and mounted workspace"
                        timeout 120s docker run --rm \
                          --pull=never \
                          --entrypoint /bin/sh \
                          --network "$DEVOPS_NETWORK" \
                          --user "$(id -u):$(id -g)" \
                          -e HOME=/var/jenkins_home \
                          -v "peach-jenkins-data:/var/jenkins_home" \
                          -w "$WORKSPACE" \
                          "$MAVEN_IMAGE" \
                          -lc 'echo "container started"; java -version; mvn -version; test -f /var/jenkins_home/.m2/settings.generated.xml; test -f pom.xml'

                        timeout 3600s docker run --rm \
                          --pull=never \
                          --entrypoint /bin/sh \
                          --network "$DEVOPS_NETWORK" \
                          --user "$(id -u):$(id -g)" \
                          -e HOME=/var/jenkins_home \
                          -e LANG=C.UTF-8 \
                          -e LC_ALL=C.UTF-8 \
                          -e MAVEN_OPTS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8  -Daether.connector.connectTimeout=10000 -Daether.connector.requestTimeout=60000 -Dmaven.wagon.http.connectionTimeout=10000 -Dmaven.wagon.http.readTimeout=60000" \
                          -e JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8" \
                          -v "peach-jenkins-data:/var/jenkins_home" \
                          -w "$WORKSPACE" \
                          "$MAVEN_IMAGE" \
                          -lc 'mvn -B -Pdocker \
                            -s /var/jenkins_home/.m2/settings.generated.xml \
                            -Dmaven.repo.local=/var/jenkins_home/.m2/repository \
                            -Dpeach.nexus.url="$PEACH_NEXUS_URL" \
                            -Dfile.encoding=UTF-8 \
                            -Dsun.jnu.encoding=UTF-8 \
                            -Daether.connector.connectTimeout=10000 \
                            -Daether.connector.requestTimeout=60000 \
                            -Dmaven.wagon.http.connectionTimeout=10000 \
                            -Dmaven.wagon.http.readTimeout=60000 \
                            -DskipTests clean package'
                    '''
                }
            }
        }

        stage('Build and push images') {
            steps {
                withCredentials([file(credentialsId: env.DEPLOY_ENV_CREDENTIAL, variable: 'DEPLOY_ENV_FILE')]) {
                    sh '''
                        build_image() {
                          service="$1"
                          jar_path="$2"
                          title="$3"
                          description="$4"

                          rm -rf deploy-pipline/build-context
                          mkdir -p deploy-pipline/build-context
                          cp "$jar_path" deploy-pipline/build-context/app.jar

                          docker build \
                            --build-arg JAR_FILE=build-context/app.jar \
                            --build-arg IMAGE_TITLE="$title" \
                            --build-arg IMAGE_DESCRIPTION="$description" \
                            --build-arg IMAGE_AUTHORS="${IMAGE_AUTHORS:-Mr Shu}" \
                            --build-arg IMAGE_VENDOR="${IMAGE_VENDOR:-Peach Cloud}" \
                            --build-arg IMAGE_VERSION="$IMAGE_TAG" \
                            -f deploy-pipline/docker/Dockerfile.service \
                            -t "$IMAGE_PREFIX/$service:$IMAGE_TAG" \
                            deploy-pipline
                          docker push "$IMAGE_PREFIX/$service:$IMAGE_TAG"
                        }

                        is_selected() {
                          case " $SELECTED_SERVICES " in
                            *" $1 "*) return 0 ;;
                            *) return 1 ;;
                          esac
                        }

                        set -a
                        . "$DEPLOY_ENV_FILE"
                        set +a

                        if is_selected peach-gateway; then build_image peach-gateway peach-gateway/peach-gateway-launch/target/peach-gateway-launch-1.0.0-SNAPSHOT.jar "Peach Gateway" "Peach Cloud gateway service"; fi
                        if is_selected peach-auth; then build_image peach-auth peach-auth/peach-auth-launch/target/peach-auth-launch-1.0.0-SNAPSHOT.jar "Peach Auth" "Peach Cloud authentication and authorization service"; fi
                        if is_selected peach-monitor; then build_image peach-monitor peach-monitor/peach-monitor-launch/target/peach-monitor-launch-1.0.0-SNAPSHOT.jar "Peach Monitor" "Peach Cloud monitoring service"; fi
                        if is_selected peach-fileservice; then build_image peach-fileservice peach-fileservice/peach-fileservice-launch/target/peach-fileservice-launch-1.0.0-SNAPSHOT.jar "Peach Fileservice" "Peach Cloud file service"; fi
                        if is_selected peach-message; then build_image peach-message peach-message/peach-message-launch/target/peach-message-launch-1.0.0-SNAPSHOT.jar "Peach Message" "Peach Cloud message service"; fi
                        if is_selected peach-setting; then build_image peach-setting peach-setting/peach-setting-launch/target/peach-setting-launch-1.0.0-SNAPSHOT.jar "Peach Setting" "Peach Cloud setting service"; fi
                        if is_selected peach-generator; then build_image peach-generator peach-generator/peach-generator-launch/target/peach-generator-launch-1.0.0-SNAPSHOT.jar "Peach Generator" "Peach Cloud code generator service"; fi
                        if is_selected peach-scheduled; then build_image peach-scheduled peach-scheduled/peach-scheduled-launch/target/peach-scheduled-launch-1.0.0-SNAPSHOT.jar "Peach Scheduled" "Peach Cloud scheduled task service"; fi
                    '''
                }
            }
        }

        stage('Build frontend') {
            steps {
                withCredentials([file(credentialsId: env.DEPLOY_ENV_CREDENTIAL, variable: 'DEPLOY_ENV_FILE')]) {
                    sh '''
                    set -a
                    . "$DEPLOY_ENV_FILE"
                    set +a

                    case " $SELECTED_SERVICES " in
                      *" peach-front "*) ;;
                      *) echo "Skipping frontend image because peach-front is not selected"; exit 0 ;;
                    esac

                    docker run --rm \
                      --user "$(id -u):$(id -g)" \
                      -e HOME=/tmp \
                      -v "peach-jenkins-data:/var/jenkins_home" \
                      -w "$WORKSPACE/peach-cloud-front" \
                      node:22-alpine \
                      sh -c 'npm ci && npm run build'

                    rm -rf deploy-pipline/front-dist
                    mkdir -p deploy-pipline/front-dist
                    cp -R peach-cloud-front/dist/. deploy-pipline/front-dist/

                    docker build \
                      --build-arg IMAGE_AUTHORS="${IMAGE_AUTHORS:-Mr Shu}" \
                      --build-arg IMAGE_VENDOR="${IMAGE_VENDOR:-Peach Cloud}" \
                      --build-arg IMAGE_VERSION="$IMAGE_TAG" \
                      -f deploy-pipline/docker/Dockerfile.front \
                      -t "$IMAGE_PREFIX/peach-front:$IMAGE_TAG" \
                      deploy-pipline
                    docker push "$IMAGE_PREFIX/peach-front:$IMAGE_TAG"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: env.DEPLOY_ENV_CREDENTIAL, variable: 'DEPLOY_ENV_FILE')]) {
                    sh '''
                        set -eu
                        set -a
                        . "$DEPLOY_ENV_FILE"
                        set +a

                        mkdir -p "$DEPLOY_ROOT/deploy/runtime/logs/nginx" "$DEPLOY_ROOT/sql"
                        cp -R deploy/docker deploy/nacos "$DEPLOY_ROOT/deploy/"
                        cp deploy-pipline/docker-compose.deploy.yml "$DEPLOY_ROOT/deploy/docker-compose.yml"
                        cp deploy-pipline/import-nacos.sh "$DEPLOY_ROOT/deploy/nacos/import-nacos.sh"
                        chmod +x "$DEPLOY_ROOT/deploy/nacos/import-nacos.sh"
                        cp sql/ALL_TABLE_CREATE.sql sql/INIT.sql "$DEPLOY_ROOT/sql/"

                        export PEACH_IMAGE_PREFIX="$IMAGE_PREFIX"
                        export PEACH_IMAGE_TAG="$IMAGE_TAG"
                        export PEACH_ENV_FILE="$DEPLOY_ENV_FILE"
                        export NACOS_ADDR='http://nacos:8848'
                        if ! docker network inspect "$DEVOPS_NETWORK" >/dev/null 2>&1; then
                          echo "Required DevOps network is missing: $DEVOPS_NETWORK. Start deploy-pipline/pipline/docker-compose.yml before running this pipeline." >&2
                          exit 1
                        fi
                        for container in peach-prometheus peach-tempo peach-otel-collector peach-loki peach-alloy peach-grafana; do
                          status=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || true)
                          if [ "$status" != "running" ]; then
                            echo "Required observability container is not running: $container (status=${status:-missing})" >&2
                            exit 1
                          fi
                        done
                        docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" pull $SELECTED_SERVICES
                        docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" up -d mysql redis nacos
                        docker network inspect "$DEPLOY_NETWORK" >/dev/null
                        docker network connect "$DEPLOY_NETWORK" jenkins 2>/dev/null || true
                        docker network connect "$DEPLOY_NETWORK" peach-devops-nginx 2>/dev/null || true
                        for container in peach-mysql peach-redis peach-nacos; do
                          i=0
                          until [ "$i" -ge 90 ]; do
                            status=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)
                            if [ "$status" = "healthy" ] || [ "$status" = "running" ]; then
                              break
                            fi
                            i=$((i + 1))
                            sleep 2
                          done
                          if [ "$i" -ge 90 ]; then
                            echo "Container is not healthy: $container" >&2
                            exit 1
                          fi
                        done
                        docker cp "$DEPLOY_ROOT/sql/ALL_TABLE_CREATE.sql" peach-mysql:/tmp/ALL_TABLE_CREATE.sql
                        docker cp "$DEPLOY_ROOT/sql/INIT.sql" peach-mysql:/tmp/INIT.sql
                        table_count=$(docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" exec -T mysql sh -c 'mysql --default-character-set=utf8mb4 -h 127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE" -Nse "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE();"')
                        if [ "$table_count" = "0" ]; then
                          docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" exec -T mysql sh -c 'mysql --default-character-set=utf8mb4 -h 127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE" < /tmp/ALL_TABLE_CREATE.sql'
                        fi
                        docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" exec -T mysql sh -c 'mysql --default-character-set=utf8mb4 -h 127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE" < /tmp/INIT.sql'
                        sh "$DEPLOY_ROOT/deploy/nacos/import-nacos.sh"
                        if [ "$STOP_UNSELECTED" = "true" ] && [ -n "$UNSELECTED_SERVICES" ]; then
                          docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" stop $UNSELECTED_SERVICES
                        fi
                        docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" up -d --no-build --no-deps $SELECTED_SERVICES
                        docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_ROOT/deploy/docker-compose.yml" ps
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment succeeded: ${IMAGE_PREFIX}:${IMAGE_TAG}"
        }
        failure {
            sh 'docker ps --format "table {{.Names}}\\t{{.Image}}\\t{{.Status}}" || true'
        }
        always {
            sh 'rm -rf deploy-pipline/build-context deploy-pipline/front-dist || true'
        }
    }
}
