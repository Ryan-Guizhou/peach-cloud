        )
    </insert>

    <insert id="batchInsert" parameterType="com.peach.message.entity.SiteMessageDO">
        INSERT INTO PEACH_SITE_MESSAGE (
            <include refid="allColumn" />
        ) VALUES
        <foreach collection="list" index="index" item="item" separator=",">
            (<include refid="itemAllColumnValue"/>)
        </foreach>
    </insert>

    <update id="updateById" parameterType="com.peach.message.entity.SiteMessageDO">
        UPDATE PEACH_SITE_MESSAGE SET
            <include refid="allColumnSet" />
        WHERE ID = #{id,jdbcType=VARCHAR}
    </update>

    <update id="revokeBySource">
        UPDATE PEACH_SITE_MESSAGE
        SET SEND_STATUS = 'REVOKED'
        WHERE SOURCE_CODE = #{sourceCode,jdbcType=VARCHAR}
        <if test="sourceType != null and sourceType != ''">
            AND SOURCE_TYPE = #{sourceType,jdbcType=VARCHAR}
        </if>
    </update>

    <update id="readAllByReceiver">
        UPDATE PEACH_SITE_MESSAGE
        SET READ_FLAG = 1,
            MODIFY_TIME = #{modifyTime,jdbcType=VARCHAR}
        WHERE RECEIVER_ID = #{receiverId,jdbcType=VARCHAR}
          AND READ_FLAG = 0
          AND SEND_STATUS = 'SENT'
        <if test="messageType != null and messageType != ''">
          AND MESSAGE_TYPE = #{messageType,jdbcType=VARCHAR}
        </if>
        <if test="messageTypeList != null and messageTypeList.size() > 0">
          AND MESSAGE_TYPE IN
          <foreach collection="messageTypeList" index="index" item="messageTypeItem" open="(" separator="," close=")">
            #{messageTypeItem,jdbcType=VARCHAR}
          </foreach>
        </if>
    </update>

    <select id="selectById" parameterType="string" resultType="com.peach.message.vo.SiteMessageVO">
        SELECT
            <include refid="allColumnAlias" />
        FROM PEACH_SITE_MESSAGE
