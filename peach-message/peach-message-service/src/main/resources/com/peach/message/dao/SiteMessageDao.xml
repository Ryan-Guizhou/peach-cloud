        FROM PEACH_SITE_MESSAGE
<!--        <where>-->
<!--            <include refid="allColumnCond" />-->
<!--        </where>-->
        ORDER BY READ_FLAG ASC, CREATED_TIME DESC
    </select>

    <select id="countUnread" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM PEACH_SITE_MESSAGE
        WHERE RECEIVER_ID = #{receiverId,jdbcType=VARCHAR}
          AND READ_FLAG = 0
          AND SEND_STATUS = 'SENT'
        <if test="messageType != null and messageType != ''">
          AND MESSAGE_TYPE = #{messageType,jdbcType=VARCHAR}
        </if>
        <if test="messageTypeList != null and messageTypeList.size() > 0">
