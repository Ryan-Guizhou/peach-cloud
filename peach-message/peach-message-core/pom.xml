    <packaging>jar</packaging>
    <parent>
        <groupId>com.peach</groupId>
        <artifactId>peach-message</artifactId>
        <version>${revision}</version>
    </parent>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
